Options -Indexes
DirectoryIndex index.html

AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Une seule adresse : https://www.rgplomberie.com (certificat Let's Encrypt OVH actif).
    RewriteCond %{SERVER_PORT} 80 [OR]
    RewriteCond %{HTTP_HOST} ^rgplomberie\.com$ [NC]
    RewriteRule ^(.*)$ https://www.rgplomberie.com/$1 [R=301,L]

    # Tant que le site complet n'est pas validé, seule la page de dépannage est publiée :
    # toute autre adresse (anciennes pages encore présentes sur le serveur) renvoie vers l'accueil.
    RewriteCond %{REQUEST_URI} !^/$
    RewriteCond %{REQUEST_URI} !^/(index\.html|robots\.txt|favicon\.ico|favicon\.svg|apple-touch-icon\.png|apercu-partage\.jpg)$
    RewriteCond %{REQUEST_URI} !^/(img|\.well-known)/
    RewriteRule ^ https://www.rgplomberie.com/ [R=302,L]

</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 month"
</IfModule>
